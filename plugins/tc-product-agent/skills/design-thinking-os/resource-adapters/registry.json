{
  "version": 1,
  "rule": "接入库不等于复制网址。每个资源必须有 mode / search / returns / acquire / license / fallback。mode=reference 的不得假装能自动安装或抓取。",
  "searchOrder": [
    "asset-memory",
    "local-preset",
    "auto-adapter",
    "mcp-if-authed",
    "reference-link"
  ],
  "adapters": [
    {
      "id": "asset-memory",
      "stage": [
        "all"
      ],
      "capability": "memory",
      "mode": "auto",
      "priority": "S",
      "search": "python3 scripts/asset_memory.py search <关键词>",
      "returns": "已验收资产：模式 / 页面 / 风格 / 动效 / 组件",
      "acquire": "优先于任何外部库",
      "license": "本项目或本 Skill 沉淀",
      "fallback": "没有命中再走外部 adapter",
      "wired": true
    },
    {
      "id": "mobbin",
      "stage": [
        "research",
        "flow",
        "interaction",
        "ui"
      ],
      "capability": "reference",
      "mode": "mcp",
      "priority": "S",
      "endpoint": "https://api.mobbin.com/mcp",
      "tools": [
        "search_screens",
        "search_flows",
        "search_sections"
      ],
      "auth": "OAuth；需要 Mobbin Pro / Team / Enterprise",
      "search": "按用户任务和界面状态搜，不搜产品名当风格",
      "returns": "真实产品截图、流程、区块和 Mobbin 链接",
      "acquire": "只作参考，不复制品牌资产和文案",
      "license": "Mobbin 会员内容，不得再分发截图库",
      "fallback": "未授权或无套餐：打开 https://mobbin.com/search/<query> 给用户看，不抓取。改用内部资产和公开产品。",
      "wired": true
    },
    {
      "id": "pageflows",
      "stage": [
        "research",
        "flow"
      ],
      "capability": "reference",
      "mode": "reference",
      "priority": "S",
      "url": "https://pageflows.com",
      "search": "按任务类型打开分类（onboarding / checkout / permission / search）",
      "returns": "无公开 API。只给用户链接和自己记录的步骤观察。",
      "acquire": null,
      "license": "付费站点，不抓取",
      "fallback": "用 Mobbin search_flows；或用户提供录屏",
      "wired": true
    },
